# --- Flask ---
SECRET_KEY=change-me-to-a-random-string
# REQUIRED for click tracking to work -- must be your real public domain,
# not localhost. Pinterest visitors' clicks route through this domain's
# /go/<id> redirect on their way to the affiliate link; Publish refuses to
# run if this still says localhost, since a real deployment needs a real URL.
# Example: https://pinforge.reallygoodgadgets.store
APP_BASE_URL=http://localhost:5000

# --- Login (this app is fully public on the internet -- this is what locks it) ---
# Required. Without this set, nobody can log in at all (fails closed, not open).
ADMIN_PASSWORD=
# How many days a login stays valid before you have to sign in again.
SESSION_LIFETIME_DAYS=7
# Leave at 1 (the default) when running behind Caddy/HTTPS, which is every
# real deployment. Only set to 0 if you're accessing the app directly over
# plain HTTP on your local network (bypassing Caddy) -- otherwise the login
# cookie won't be sent and you'll get stuck in a redirect loop.
SESSION_COOKIE_SECURE=1

# --- Amazon Creators API ---
# The old Product Advertising API (PA-API) was retired by Amazon on
# May 15, 2026. Get these from Associates Central -> Tools -> Creators API
# (Create Application -> Add New Credential). Requires 10+ qualified sales
# in the trailing 30 days -- until you have that, PinForge automatically
# falls back to reading the public product page (title + image, no price).
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=reallygoodgadgets-20
AMAZON_COUNTRY=US

# --- Pinterest API (v5) ---
# From https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must exactly match a redirect URI registered on your Pinterest app
PINTEREST_REDIRECT_URI=http://localhost:5000/auth/pinterest/callback
# Set to 1 while your app only has Trial access -- Pinterest blocks Trial
# apps from creating real pins on the production API entirely (error code
# 29). Sandbox pins use the same token/credentials above, they're just
# only visible to you, not the public -- this is what lets you test the
# full pipeline (and record the demo video Standard access requires)
# before you're actually approved. Set back to 0 once Standard access is
# granted, so pins go live for real.
PINTEREST_USE_SANDBOX=1

# --- Branding for generated pin images ---
BRAND_NAME=Really Good Gadgets
BRAND_WEBSITE=reallygoodgadgets.com
BRAND_ACCENT_COLOR=#E63946

# --- Scout (automated product discovery) ---
# Optional: run all active watches automatically every N hours.
# Leave blank to only run Scout manually (button in the UI) or via your
# own cron hitting POST /api/scout/run.
SCOUT_INTERVAL_HOURS=

# --- WooCommerce affiliate products (optional) ---
# Publishes each pin as a real WooCommerce product (External/Affiliate
# type) on your own site, so Pinterest sends traffic there first instead
# of straight to the affiliate link -- lets you run ads and keep the
# visitor on your own domain. Since it's a real product (not a blog post),
# it shows up in New Arrivals / Shop / category pages automatically,
# wherever your theme already surfaces products, with zero theme changes.
#
# Get REST API keys (separate from your WordPress login) in wp-admin:
# WooCommerce -> Settings -> Advanced -> REST API -> Add key.
# Set permissions to "Read/Write" -- Read-only can't create products.
WORDPRESS_SITE_URL=https://reallygoodgadgets.store
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
