#  GNU nano 8.4                          .env
# --- Flask ---
SECRET_KEY=xBI7GcwmDhMYdrFiFdbfPPQmksps4ghk
APP_BASE_URL=http://localhost:5000


# From https://developers.pinterest.com/apps/

ADMIN_PASSWORD=xBI7GcwmDhMYdrFiFdbfPPQmksps4ghk
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SECURE=1

# --- Amazon Product Advertising API (PA-API 5.0) ---
# From your Amazon Associates account -> Tools -> Product Advertising API
# --- Amazon Creators API ---
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=reallygoodgadgets-20
AMAZON_COUNTRY=US

# --- Pinterest API (v5) ---
# From https://developers.pinterest.com/apps/
PINTEREST_APP_ID=1598832
PINTEREST_APP_SECRET=391b1fc65c8a4e5894ead37f8c217cace362df01
# Must exactly match a redirect URI registered on your Pinterest app
PINTEREST_REDIRECT_URI=https://pinforge.reallygoodgadgets.store/auth/pinterest/callback

# --- Branding for generated pin images ---
BRAND_NAME=Really Good Gadgets
BRAND_WEBSITE=reallygoodgadgets.com
BRAND_ACCENT_COLOR=#E63946

# --- Scout (automated product discovery) ---
# Optional: run all active watches automatically every N hours.
# Leave blank to only run Scout manually (button in the UI) or via your
# own cron hitting POST /api/scout/run.
SCOUT_INTERVAL_HOURS=
